<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection gives the app Windows' OCR (Windows.Media.Ocr), which needs no package identity or NPU. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the notification area icon (Views/TrayIcon), which WPF doesn't have. Its types are always written
         in full: the implicit usings for it are removed below, so MessageBox, Clipboard and Application stay WPF's. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Made from packaging\Assets\Square44x44Logo.targetsize-*_altform-unplated.png: the window's, the taskbar's and the
         notification area's icon. -->
    <ApplicationIcon>QuickDescribe.ico</ApplicationIcon>
    <AssemblyName>QuickDescribe</AssemblyName>
    <RootNamespace>QuickDescribe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- LibraryImport generates code that passes pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickDescribe.Tests" />
    <!-- WPF projects leave System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
